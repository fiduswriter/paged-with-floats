    "Erik Schilling",
    "Marius Dumitru Florea",
    "Nigel Cunningham",
    "William Muir",
    "Martin Olsson",
    "Nathan Schulzke",
    "Gijs de Heij",
    "Andrey Kislyuk",
    "Angela Liu",
    "Chris Beaven",
    "Edoardo Tona",
    "JenniferVdL",
    "Jonathan Boarman",
    "Lucas Willems",
    "Malte Rohde",
    "Mauro Bieg",
    "Nicholas Wylie",
    "Patrick Kranz",
    "Rob Mayer",
    "Sam Ruby",
    "Stéphane Elbaron",
    "Talbi Youssef",
    "Urban Suppiger",
    "Yann Trividic",
    "Antoine Fauchié",
    "mb21",
    "wangfengming",
    "wenbei421"
  ],
  "license": "LGPL-3.0-or-later",
  "homepage": "https://github.com/johanneswilm/paged-with-floats#readme",
  "bugs": {
    "url": "https://github.com/johanneswilm/paged-with-floats/issues"
  },
  "keywords": [
    "pagination",
    "paged-media",
    "css",
    "print",
    "page-floats",
    "pdf",
    "browser"
  ],
  "main": "src/index.js",
  "browser": "dist/paged.js",
  "type": "module",
  "exports": {
    "import": "./src/index.js",
    "require": "./lib/index.cjs",
    "browser": "./dist/paged.js",
    "polyfill": "./dist/paged.polyfill.js",
    "default": "./src/index.js"
  },
  "dependencies": {
    "@babel/polyfill": "^7.10.1",
    "@babel/runtime": "^7.21.0",
    "clear-cut": "^2.0.2",
    "css-tree": "^1.1.3",
    "event-emitter": "^0.3.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.4",
    "@babel/plugin-proposal-async-generator-functions": "^7.20.7",
    "@babel/plugin-transform-runtime": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@rollup/plugin-commonjs": "^24.1.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.2",
    "@rollup/plugin-terser": "^0.4.1",
    "babel-plugin-replace-import-extension": "^1.1.3",
    "chalk": "^5.2.0",
    "eslint": "^8.38.0",
    "express": "^4.18.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-image-snapshot": "^6.5.2",
    "playwright-core": "1.62.1",
    "rimraf": "^5.0.0",
    "rollup": "^3.20.6",
    "rollup-plugin-license": "^3.0.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-node-builtins": "^2.1.2",
    "rollup-plugin-serve": "^2.0.2"
  },
  "scripts": {
    "build": "rollup -c",
    "start": "rollup -w -c rollup.server.config.js",
    "test": "npm run lint && jest",
    "specs": "npm run pretest && jest --config=specs/jest.config.js",
    "compile": "babel src/ -d lib/ --out-file-extension .cjs",
    "legacy": "babel dist/paged.js --out-file dist/paged.legacy.js && babel dist/paged.polyfill.js --out-file dist/paged.polyfill.legacy.js",
    "pretest": "npm run build && npm run compile",
    "prepublishOnly": "npm run build && npm run compile && npm run legacy",
    "watch": "rollup -w -c",
    "lint": "eslint -c .eslintrc.json src specs",
    "specs-dom": "jest --config=specs/jest.config.js page-floats data64 filters/undisplayed filters/script-elements splits/tables/long-table whitespaces/whitespaces.spec.js",
    "docker-specs": "docker build -t paged-with-floats . && docker run --rm --ipc=host -v $(pwd)/specs:/home/pwuser/pagedjs/specs paged-with-floats npm run specs",
    "docker-update-specs": "docker build -t paged-with-floats . && docker run --rm --ipc=host -v $(pwd)/specs:/home/pwuser/pagedjs/specs paged-with-floats npm run specs -- -u"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johanneswilm/paged-with-floats.git"
  },
  "files": [
    "dist",
    "lib",
    "src",
    "LICENSE.md",
    "COPYING",
    "COPYING.LESSER"
  ]
}
