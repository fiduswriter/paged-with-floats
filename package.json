{
  "name": "paged-with-floats",
  "version": "0.6.1",
  "description": "Fork of Paged.js: chunks up a document into paged media flows, applies print styles, and adds support for CSS page floats",
  "author": "Johannes Wilm",
  "maintainers": [
    {
      "name": "Johannes Wilm"
    }
  ],
  "contributors": [
    "Fred Chasen",
    "Julien Taquet",
    "Guillaume Grossetie",
